    type: Organization
    name: Exempelmyndighetens API-support
    email: api-support@exempelmyndigheten.example
    phone: "0701740610"
    address: Exempelgatan 12; 11122; Stockholm; Sverige
  type: REST
  keyword-sv: lediga jobb; arbetsmarknad; län; rest; api
  theme: ECON; SOCI
  conformsTo:
    about: https://spec.openapis.org/oas/v3.0.3
    title-sv: OpenAPI Specification 3.0.3
    description-sv: API:et är beskrivet enligt OpenAPI 3.0.3.
  servesDataset: https://exempelmyndigheten.example/data/lediga-jobb-per-lan
  licensedoc:
    about: http://creativecommons.org/licenses/by/4.0/
    title-sv: Creative Commons Erkännande 4.0
    description-sv: Data som hämtas via API:et får återanvändas fritt om källan anges.
  accessRights: Public
  landingPage: https://exempelmyndigheten.example/utvecklare/lediga-jobb-lan-api
  page:
