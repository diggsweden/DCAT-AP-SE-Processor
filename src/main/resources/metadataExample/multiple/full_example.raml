    title-sv: Exempelmyndighetens informationsmodell för platsannonser 1.2
    description-sv: Beskriver fält, kodlistor och regler för aggregering av platsannonser.
  temporal:
    startDate: 2021-06-01
    endDate: 2026-09-30
  accessRights: Public
  offers:
    description-sv: Datamängden är avgiftsfri.
    page: https://exempelmyndigheten.example/oppna-data/villkor
  page:
    about: https://exempelmyndigheten.example/oppna-data/lediga-jobb-per-lan/dokumentation
    title-sv: Dokumentation för Lediga jobb per län
    description-sv: Beskrivning av fält, uppdateringsrutiner och kända begränsningar i datamängden.
  distribution:
    about: https://exempelmyndigheten.example/data/lediga-jobb-per-lan/json
    title-sv: Lediga jobb per län (JSON)
    description-sv: Hela datamängden som en JSON-fil, uppdaterad dagligen.
    accessURL: https://api.exempelmyndigheten.example/lediga-jobb-lan/v1
