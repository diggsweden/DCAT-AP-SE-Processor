#%RAML 1.0
title: Annotation exempel api
description: Annotation exempel api är ett påhittat api som använder sig av annotations för att skapa metadata för DCAT-AP-SE. Organisationen Exempelmyndigheten och all data nedan är fiktiv.
version: 1.0.0

annotationTypes:
  dcat-dataset:
    properties:
      about: string
      title-sv: string
      description-sv: string
      creator:
        properties:
          about: string
          name: string
          type: string
          homepage: string
          mbox: string
      other agent:
        properties:
          about: string
          name: string
          type: string
          homepage: string
          mbox: string
          role: string
      contactPoint:
        properties:
          about: string
          type: string
          name: string
          email: string
          phone: string
          address: string
      keyword-sv: string
      theme: string
      identifier: string
      adms: string
      issued: string
      modified: string
      landingPage: string
      temporalResolution: string
      spatialResolutionInMeters: string
      version: string
      versionNotes: string
      accessRights: string
      isReferencedBy: string
      relation: string
      spatialUrl: string
      conformsTo:
        properties:
          about: string
          title-sv: string
          description-sv: string
      offers:
        properties:
          description-sv: string
          page: string
      page:
        properties:
          about: string
          title-sv: string
          description-sv: string
      temporal:
        properties:
          startDate: string
          endDate: string
      distribution:
        properties:
          about: string
          title-sv: string
          description-sv: string
          accessURL: string
          downloadURL: string
          formatMedia: string
          accessService: string
          temporalResolution: string
          spatialResolutionInMeters: string
          byteSize: integer
          issued: string
          modified: string
          status: string
          availability: string
          licenseurl: string
          rights:
            properties:
              attributionText-sv: string
              attributionURL: string
              copyrightNotice: string
              copyrightStatement:
                properties:
                  about: string
                  title-sv: string
                  description-sv: string
              copyrightYear: integer
              copyrightHolder:
                properties:
                  about: string
                  name: string
                  type: string
                  homepage: string
                  mbox: string
              jurisdiction: string
              reuserGuidelines: string
          checksum:
            properties:
              value: string
          page:
            properties:
              about: string
              title-sv: string
              description-sv: string
          conformsTo:
            properties:
              about: string
              title-sv: string
              description-sv: string
  dcat-dataservice:
    properties:
      about: string
      title-sv: string
      description-sv: string
      endpointURL: string
      endpointDescription: string
      publisher:
        properties:
          about: string
          name: string
          type: string
          homepage: string
          mbox: string
      contactPoint:
        properties:
          about: string
          type: string
          name: string
          email: string
          phone: string
          address: string
      type: string
      keyword-sv: string
      theme: string
      conformsTo:
        properties:
          about: string
          title-sv: string
          description-sv: string
      servesDataset: string
      licensedoc:
        properties:
          about: string
          title-sv: string
          description-sv: string
      accessRights: string
      landingPage: string
      page:
        properties:
          about: string
          title-sv: string
          description-sv: string

(dcat-dataset):
  about: https://exempelmyndigheten.example/data/lediga-jobb-per-lan
  title-sv: Lediga jobb per län
  description-sv: Antal publicerade lediga jobb per län och yrkesområde. Datamängden uppdateras dagligen och omfattar annonser publicerade sedan juni 2021.
  creator:
    about: https://exempelmyndigheten.example/#org
    name: Exempelmyndigheten
    type: NationalAuthority
    homepage: https://exempelmyndigheten.example
    mbox: oppnadata@exempelmyndigheten.example
  other agent:
    about: https://exempeldata.example/#org
    name: Exempeldata AB
    type: Company
    homepage: https://exempeldata.example
    mbox: kundtjanst@exempeldata.example
    role: distributor
  contactPoint:
    about: https://exempelmyndigheten.example/#oppnadata-kontakt
    name: Exempelmyndighetens funktion för öppna data
    type: Organization
    email: oppnadata@exempelmyndigheten.example
    address: Exempelgatan 12; 11122; Stockholm; Sverige
    phone: "0701740605"
  keyword-sv: lediga jobb; arbetsmarknad; platsannonser; län; region
  keyword-en: job vacancies; labour market; job ads; county; region
  theme: ECON; SOCI
  issued: 2021-06-01
  modified: 2026-09-30
  spatialUrl: http://publications.europa.eu/resource/authority/country/SWE
  location:
    bbox: POLYGON((10.96 55.34, 24.17 55.34, 24.17 69.06, 10.96 69.06, 10.96 55.34))
    centroid: POINT(17.3 62.2)
    geometry: POLYGON((10.96 55.34, 24.17 55.34, 24.17 69.06, 10.96 69.06, 10.96 55.34))
  version: 2.1.0
  versionNotes: Uppdelning på yrkesområde tillagd; Länskoder uppdaterade enligt gällande indelning
  landingPage: https://exempelmyndigheten.example/oppna-data/lediga-jobb-per-lan
  temporalResolution: P1D
  spatialResolutionInMeters: 10000
  relation: https://exempelmyndigheten.example/data/lediga-jobb-per-kommun
  isReferencedBy: https://exempelmyndigheten.example/rapporter/arbetsmarknadslaget-2025
  identifier: exempelmyndigheten.example/data/lediga-jobb-per-lan
  adms: exempelmyndigheten.example/id/dataset/EXM-DS-0043
  conformsTo:
