(dcat-dataservice):
  about: https://exempelmyndigheten.example/api/lediga-jobb-lan
  title-sv: Lediga jobb per län-API
  description-sv: REST-API för att hämta antal lediga jobb per län och yrkesområde, med filtrering på datum.
  endpointURL: https://api.exempelmyndigheten.example/lediga-jobb-lan/v1
  endpointDescription: https://api.exempelmyndigheten.example/lediga-jobb-lan/v1/openapi.yaml
  publisher:
    about: https://exempelmyndigheten.example/#org
    name: Exempelmyndigheten
    type: NationalAuthority
    homepage: https://exempelmyndigheten.example
    mbox: oppnadata@exempelmyndigheten.example
  contactPoint:
