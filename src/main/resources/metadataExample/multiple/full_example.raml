    accessService: https://exempelmyndigheten.example/api/lediga-jobb-lan
    temporalResolution: P1D
    spatialResolutionInMeters: 10000
    byteSize: 185000
    issued: 2021-06-01
    modified: 2026-09-30
    status: Completed
    availability: Stable
    licenseurl: CC BY 4.0
    rights:
