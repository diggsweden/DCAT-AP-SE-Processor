{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>diggsweden/.github:renovate-base",
    ":maintainLockFilesWeekly"
  ],
  "enabledManagers": [
    "github-actions",
    "maven",
    "dockerfile",
    "mise"
  ],
  "hostRules": [
    {
      "matchHost": "repo.maven.apache.org",
      "concurrentRequestLimit": 1,
      "maxRequestsPerSecond": 1
    }
  ],
  "packageRules": [
    {
      "description": "Maven dependencies - Major updates",
      "matchManagers": ["maven"],
      "matchUpdateTypes": ["major"],
      "addLabels": ["java", "dependencies", "major-update"],
      "groupName": "java major"
    },
    {
      "description": "Maven dependencies - Non-major updates",
      "matchManagers": ["maven"],
      "matchUpdateTypes": ["minor", "patch"],
      "addLabels": ["java", "dependencies"],
      "groupName": "java non-major"
    },
    {
      "description": "Docker base images",
      "matchManagers": ["dockerfile"],
      "addLabels": ["docker", "infrastructure"]
    },
    {
      "description": "Mise tools - Major updates",
      "matchManagers": ["mise"],
      "matchUpdateTypes": ["major"],
      "addLabels": ["tools", "major-update"],
      "groupName": "mise major"
    },
    {
      "description": "Mise tools - Non-major updates",
      "matchManagers": ["mise"],
      "matchUpdateTypes": ["minor", "patch"],
      "addLabels": ["tools"],
      "groupName": "mise non-major"
    },
    {
      "description": "Security and compliance tools",
      "matchManagers": ["mise"],
      "matchPackageNames": [
        "aqua:zricethezav/gitleaks",
        "aqua:siderolabs/conform",
        "aqua:rhysd/actionlint"
      ],
      "addLabels": ["security-tools"],
      "groupName": "security tools"
    },
    {
      "description": "Documentation and build tools",
      "matchManagers": ["mise"],
      "matchPackageNames": [
        "aqua:google/yamlfmt",
        "aqua:rvben/rumdl",
        "github:italia/publiccode-parser-go",
        "aqua:casey/just"
      ],
      "addLabels": ["documentation"],
      "groupName": "documentation tools"
    }
  ]
}
